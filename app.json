{
  "expo": {
    "name": "speaker-picker",
    "description": "Expo Speaker Picker",
    "slug": "speaker-picker",
    "platforms": [
      "ios",
      "android",
      "web"
    ],
    "version": "1.1.0",
    "orientation": "portrait",
    "icon": "./src/assets/images/icon.png",
    "userInterfaceStyle": "automatic",
    "web": {
      "bundler": "metro"
    },
    "splash": {
      "image": "./src/assets/images/splash.png"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "app.munctl.speakerpicker"
    },
    "androidStatusBar": {
      "backgroundColor": "#000000"
    },
    "android": {
      "package": "app.munctl.speakerpicker"
    },
    "plugins": [
      "expo-font"
    ]
  }
}
